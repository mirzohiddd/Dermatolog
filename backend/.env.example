# ===== SERVER =====
PORT=5000
# Frontend manzili (CORS uchun). Bir nechta bo‘lsa vergul bilan: http://localhost:5173,https://sayt.vercel.app
FRONTEND_URL=http://localhost:5173

# ===== TELEGRAM BOT =====
# @BotFather dan olingan token
BOT_TOKEN=

# Ikki admin Telegram ID si (faqat raqam). @userinfobot orqali bilib olish mumkin.
ADMIN_ID_1=
ADMIN_ID_2=

# ===== ADMIN PANEL =====
ADMIN_USERNAME=
# Kamida 8 belgi
ADMIN_PASSWORD=
# Kamida 32 belgi. Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ===== IXTIYORIY (production uchun) =====
# Bot tugmasi ochadigan sayt. Bo‘sh bo‘lsa FRONTEND_URL ishlatiladi. Web App uchun https:// bo‘lishi shart.
WEBAPP_URL=
# Backendning ochiq manzili (masalan https://kaloriya-api.onrender.com). To‘ldirilsa bot webhook rejimida ishlaydi.
# Lokal kompyuterda bo‘sh qoldiring.
WEBHOOK_DOMAIN=
# JSON fayllar papkasi. Render Disk ishlatsangiz: /var/data
DATA_DIR=
# Hisoblash bo‘yicha adminlarga xabar yuborish (true/false)
NOTIFY_ON_CALCULATION=true
TIMEZONE=Asia/Tashkent
